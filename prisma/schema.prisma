generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PageStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationType {
  NEW_LEAD
  PAGE_REVIEW
  PAGE_CHANGES_REQUESTED
  PAGE_APPROVED
  PAGE_SCHEDULED
  PAGE_PUBLISHED
  PAGE_PUBLISH_FAILED
  PAGE_UNPUBLISHED
  FORM_SUBMISSION
  TASK_ASSIGNED
  LEAD_ASSIGNED
  SEO_WARNING
  SYSTEM
}

enum TaskRelationType {
  LEAD
  PAGE
  ARTICLE
  PORTFOLIO
}

enum TemplateCategory {
  BLANK
  SERVICE
  LANDING_PAGE
  PORTFOLIO
  LOCATION
  CAMPAIGN
  ABOUT
  CONTACT
  CUSTOM
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum FormFieldType {
  TEXT
  EMAIL
  PHONE
  TEXTAREA
  SELECT
  CHECKBOX
  RADIO
  DATE
  FILE
  HIDDEN
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String?
  passwordHash  String
  mustChangePassword Boolean         @default(false)
  status        UserStatus           @default(ACTIVE)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  roles         UserRole[]
  sessions      Session[]
  twoFactor     TwoFactorCredential?
  recoveryCodes RecoveryCode[]
  createdPages  Page[]               @relation("PageCreator")
  updatedPages  Page[]               @relation("PageUpdater")
  pageVersions  PageVersion[]
  media         MediaAsset[]
  auditLogs     AuditLog[]
  leadNotes     LeadNote[]
  assignedLeads Lead[]               @relation("LeadAssignee")
  assignedTasks Task[]               @relation("TaskAssignee")
  createdTasks  Task[]               @relation("TaskCreator")
  notifications Notification[]

  @@index([status])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  ipHash     String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model TwoFactorCredential {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedSecret String
  enabledAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model Page {
  id                   String        @id @default(cuid())
  title                String
  slug                 String        @unique
  status               PageStatus    @default(DRAFT)
  pageType             String        @default("STANDARD")
  /// Unpublished working copy ({title, slug, seo, sections}); live content is only replaced on publish.
  draft                Json?
  publishedAt          DateTime?
  publishAt            DateTime?
  unpublishAt          DateTime?
  submittedForReviewAt DateTime?
  submittedById        String?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewNote           String?
  approvedAt           DateTime?
  approvedById         String?
  createdById          String?
  updatedById          String?
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            User?         @relation("PageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?         @relation("PageUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  sections             PageSection[]
  versions             PageVersion[]
  seo                  SeoMetadata?

  @@index([status, publishedAt])
  @@index([deletedAt])
  @@index([status, publishAt])
  @@index([status, unpublishAt])
}

model PageSection {
  id            String       @id @default(cuid())
  pageId        String
  page          Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type          String
  order         Int
  enabled       Boolean      @default(true)
  content       Json
  style         Json?
  globalBlockId String?
  globalBlock   GlobalBlock? @relation(fields: [globalBlockId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([pageId, order])
  @@index([pageId, enabled])
  @@index([globalBlockId])
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model SeoMetadata {
  id                String   @id @default(cuid())
  pageId            String?  @unique
  page              Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  entityType        String?
  entityId          String?
  title             String?
  description       String?
  canonicalUrl      String?
  robots            String?
  ogImage           String?
  ogTitle           String?
  ogDescription     String?
  twitterImage      String?
  focusKeyword      String?
  secondaryKeywords String?
  structuredData    Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([entityType, entityId])
}

model MediaAsset {
  id          String       @id @default(cuid())
  filename    String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  alt         String?
  title       String?
  caption     String?
  storageKey  String       @unique
  publicUrl   String
  folderId    String?
  folder      MediaFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  tags        String[]     @default([])
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([mimeType])
  @@index([deletedAt])
  @@index([folderId])
}

model PortfolioCategory {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  projects  PortfolioProject[]
}

model PortfolioProject {
  id          String             @id @default(cuid())
  title       String
  slug        String             @unique
  status      PageStatus         @default(DRAFT)
  summary     String?
  content     Json?
  categoryId  String?
  category    PortfolioCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  publishAt   DateTime?
  unpublishAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model Article {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  status      PageStatus       @default(DRAFT)
  excerpt     String?
  content     Json
  categoryId  String?
  category    ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  publishAt   DateTime?
  unpublishAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Navigation {
  id        String           @id @default(cuid())
  key       String           @unique
  title     String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     NavigationItem[]
}

model NavigationItem {
  id           String     @id @default(cuid())
  navigationId String
  navigation   Navigation @relation(fields: [navigationId], references: [id], onDelete: Cascade)
  label        String
  href         String
  order        Int
  parentId     String?
  target       String?
  enabled      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([navigationId, order])
  @@index([navigationId, parentId])
}

model Form {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  active             Boolean          @default(true)
  settings           Json?
  successMessage     String?
  successRedirectUrl String?
  createLead         Boolean          @default(true)
  sendNotification   Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  fields             FormField[]
  submissions        FormSubmission[]
}

model FormField {
  id               String        @id @default(cuid())
  formId           String
  form             Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  name             String
  label            String
  type             FormFieldType
  required         Boolean       @default(false)
  options          Json?
  validation       Json?
  order            Int
  step             Int           @default(1)
  section          String?
  description      String?
  conditionalRules Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([formId, name])
  @@unique([formId, order])
}

model FormSubmission {
  id          String      @id @default(cuid())
  formId      String
  form        Form        @relation(fields: [formId], references: [id], onDelete: Restrict)
  values      Json
  utmData     Json?
  referrer    String?
  landingPage String?
  ipHash      String?
  userAgent   String?
  emailStatus EmailStatus @default(PENDING)
  emailError  String?
  leadId      String?
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([formId, createdAt])
  @@index([leadId])
}

model Lead {
  id             String           @id @default(cuid())
  name           String?
  email          String?
  phone          String?
  company        String?
  service        String?
  message        String?
  source         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  landingPage    String?
  referrer       String?
  status         LeadStatus       @default(NEW)
  statusHistory  Json?
  assignedToId   String?
  assignedTo     User?            @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  priority       LeadPriority     @default(MEDIUM)
  nextFollowUpAt DateTime?
  estimatedValue Decimal?         @db.Decimal(12, 2)
  lastActivityAt DateTime?
  tags           String[]         @default([])
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  notes          LeadNote[]
  submissions    FormSubmission[]
  activities     LeadActivity[]

  @@index([email])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@index([assignedToId])
  @@index([priority])
  @@index([nextFollowUpAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Redirect {
  id          String   @id @default(cuid())
  sourcePath  String   @unique
  destination String
  statusCode  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model GlobalSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemeSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model PageTemplate {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  definition  Json
  category    TemplateCategory @default(CUSTOM)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
}

model GlobalBlock {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  type        String        @default("custom")
  description String?
  content     Json
  style       Json?
  createdById String?
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  sections    PageSection[]
}

model Task {
  id           String            @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus        @default(TODO)
  priority     LeadPriority      @default(MEDIUM)
  dueAt        DateTime?
  completedAt  DateTime?
  assignedToId String?
  assignedTo   User?             @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  relatedType  TaskRelationType?
  relatedId    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@index([assignedToId, status])
  @@index([relatedType, relatedId])
  @@index([dueAt])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String
  entityType String?
  entityId   String?
  link       String?
  dedupeKey  String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model MediaFolder {
  id          String        @id @default(cuid())
  name        String
  parentId    String?
  parent      MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    MediaFolder[] @relation("MediaFolderTree")
  assets      MediaAsset[]
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([parentId, name])
  @@index([parentId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  subject     String
  body        String
  enabled     Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FormTemplate {
  id         String   @id @default(cuid())
  name       String
  key        String   @unique
  definition Json
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model PortfolioTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  category    String
  description String?
  definition  Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
