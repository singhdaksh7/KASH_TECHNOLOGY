# ==============================================================================
# KASH Technology Production Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database and platform security (server-side only)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://kash:change-me@localhost:5432/kash_technology?schema=public
# A high-entropy secret used only to encrypt TOTP credentials (minimum 32 random bytes).
TOTP_ENCRYPTION_KEY=replace-with-a-long-random-secret
TOTP_ISSUER=KASH Technology
# Set for one-time `npm run db:seed`; remove after bootstrap. Never commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 2. Transactional email (Resend, server-side only)
RESEND_API_KEY=re_replace_with_resend_key
RESEND_FROM_EMAIL="KASH Technology <website@your-domain.example>"

# Primary recipient email for website project inquiries (default: founder@kash-technology.com)
CONTACT_RECEIVER_EMAIL=founder@kash-technology.com

# ------------------------------------------------------------------------------
# 3. Production & Analytics Configuration (Client-Safe NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Canonical Website Base URL
NEXT_PUBLIC_SITE_URL=https://www.kash-technology.com

# Optional external booking URL (e.g. Calendly, Cal.com). If unset, defaults to /contact#consultation
NEXT_PUBLIC_BOOKING_URL=

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# If left empty, analytics scripts will not load.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML verification tag token
# If left empty, verification meta tag will not be injected.
NEXT_PUBLIC_GSC_VERIFICATION=
