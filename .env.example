# ==============================================================================
# KASH Technology Production Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Email Service / SMTP Configuration (Server-Side)
# ------------------------------------------------------------------------------
# When SMTP is not configured in local development, inquiries are safely logged to console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=founder@kash-technology.com
SMTP_PASS=your-app-password-here
SMTP_FROM="KASH Technology <website@kash-technology.com>"

# Primary recipient email for website project inquiries (default: founder@kash-technology.com)
CONTACT_RECEIVER_EMAIL=founder@kash-technology.com

# ------------------------------------------------------------------------------
# 2. Production & Analytics Configuration (Client-Safe NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Canonical Website Base URL
NEXT_PUBLIC_SITE_URL=https://www.kash-technology.com

# Optional external booking URL (e.g. Calendly, Cal.com). If unset, defaults to /contact#consultation
NEXT_PUBLIC_BOOKING_URL=

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# If left empty, analytics scripts will not load.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML verification tag token
# If left empty, verification meta tag will not be injected.
NEXT_PUBLIC_GSC_VERIFICATION=
